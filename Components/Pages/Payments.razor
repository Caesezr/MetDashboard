@page "/payments"

@using Microsoft.EntityFrameworkCore
@using MetDashboard.Data
@using MetDashboard.Data.Models
@using System.Globalization

@inject IDbContextFactory<RealEstateDbContext> DbFactory
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Payments</PageTitle>

<RadzenStack Gap="1.5rem">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="management-page-header">

        <div>

            <div class="management-page-eyebrow">
                FINANCIAL MANAGEMENT
            </div>

            <RadzenText TextStyle="TextStyle.H3"
                        Style="margin:0;">
                Payments
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Body1"
                        Style="margin-top:0.35rem;">
                View and manage rental payments across the property portfolio.
            </RadzenText>

        </div>


        <div class="management-page-actions">

            <RadzenLink Text="Add Payment"
                        Icon="add"
                        Path="/payments/add" />

        </div>

    </div>


    <!-- =====================================================
         ACTION MESSAGE
         ===================================================== -->
    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <RadzenCard class="management-message-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenIcon Icon="info"
                            Style="font-size:1.25rem;" />

                <RadzenText>
                    @actionMessage
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }


    <!-- =====================================================
         OPERATION ERROR
         ===================================================== -->
    @if (!string.IsNullOrEmpty(operationErrorMessage))
    {
        <RadzenCard class="management-operation-error-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenIcon Icon="error"
                            Style="font-size:1.25rem;" />

                <RadzenText>
                    @operationErrorMessage
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }


    <!-- =====================================================
         LOADING / LOAD ERROR
         ===================================================== -->
    @if (isLoading)
    {
        <RadzenCard>

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                           Size="ProgressBarCircularSize.Small" />

                <RadzenText>
                    Loading payments...
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }
    else if (!string.IsNullOrEmpty(loadErrorMessage))
    {
        <RadzenCard class="management-load-error-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Start"
                         Gap="1rem">

                <RadzenIcon Icon="error"
                            Style="font-size:1.5rem;" />


                <div class="management-load-error-content">

                    <div class="management-load-error-title">
                        Unable to load payments
                    </div>

                    <div class="management-load-error-description">
                        @loadErrorMessage
                    </div>


                    <RadzenButton Text="Retry"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@(_ => LoadPaymentsAsync())"
                                  class="management-load-error-retry" />

                </div>

            </RadzenStack>

        </RadzenCard>
    }
    else
    {
        <!-- =================================================
             SUMMARY CARDS
             ================================================= -->

        <RadzenRow Gap="1rem">

            <RadzenColumn Size="12"
                          SizeMD="6">

                <RadzenCard Style="height:100%;">

                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 Gap="1rem">

                        <RadzenIcon Icon="receipt_long"
                                    Style="font-size:2rem;" />

                        <div>

                            <RadzenText TextStyle="TextStyle.Overline"
                                        Style="margin:0;">
                                TOTAL PAYMENTS
                            </RadzenText>

                            <RadzenText TextStyle="TextStyle.H4"
                                        Style="margin:0.15rem 0 0 0;">
                                @totalPayments
                            </RadzenText>

                        </div>

                    </RadzenStack>

                </RadzenCard>

            </RadzenColumn>


            <RadzenColumn Size="12"
                          SizeMD="6">

                <RadzenCard Style="height:100%;">

                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 Gap="1rem">

                        <RadzenIcon Icon="payments"
                                    Style="font-size:2rem;" />

                        <div>

                            <RadzenText TextStyle="TextStyle.Overline"
                                        Style="margin:0;">
                                TOTAL RECEIVED
                            </RadzenText>

                            <RadzenText TextStyle="TextStyle.H4"
                                        Style="margin:0.15rem 0 0 0;">
                                @totalReceived
                            </RadzenText>

                        </div>

                    </RadzenStack>

                </RadzenCard>

            </RadzenColumn>

        </RadzenRow>


        <!-- =================================================
             PAYMENTS GRID
             ================================================= -->

        <RadzenCard class="management-grid-card">

            <div class="management-grid-header">

                <div>

                    <RadzenText TextStyle="TextStyle.H6"
                                Style="margin:0;">
                        Payment Register
                    </RadzenText>

                    <div class="management-grid-summary">
                        @payments.Count @(payments.Count == 1 ? "payment" : "payments") recorded
                    </div>

                </div>

            </div>


            <RadzenDataGrid TItem="PaymentDisplayItem"
                            Data="@payments"
                            AllowPaging="true"
                            PageSize="10"
                            AllowSorting="true"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            class="management-grid"
                            Style="width:100%;">

                <Columns>

                    <RadzenDataGridColumn TItem="PaymentDisplayItem"
                                          Property="PaymentId"
                                          Title="Payment ID"
                                          Width="110px" />


                    <RadzenDataGridColumn TItem="PaymentDisplayItem"
                                          Property="Property"
                                          Title="Property"
                                          Width="220px">

                        <Template Context="payment">

                            <div class="primary-grid-value">
                                @payment.Property
                            </div>

                        </Template>

                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="PaymentDisplayItem"
                                          Property="Tenant"
                                          Title="Tenant"
                                          Width="180px" />


                    <RadzenDataGridColumn TItem="PaymentDisplayItem"
                                          Property="PaymentDate"
                                          Title="Payment Date"
                                          Width="145px" />


                    <RadzenDataGridColumn TItem="PaymentDisplayItem"
                                          Property="Amount"
                                          Title="Amount"
                                          TextAlign="TextAlign.Right"
                                          Width="130px">

                        <Template Context="payment">

                            <div class="primary-grid-value">
                                @payment.Amount
                            </div>

                        </Template>

                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="PaymentDisplayItem"
                                          Property="PaymentMethod"
                                          Title="Payment Method"
                                          Width="170px" />


                    <!-- ACTIONS -->

                    <RadzenDataGridColumn TItem="PaymentDisplayItem"
                                          Title="Actions"
                                          Filterable="false"
                                          Sortable="false"
                                          TextAlign="TextAlign.Center"
                                          Width="160px">

                        <Template Context="payment">

                            <RadzenStack Orientation="Orientation.Horizontal"
                                         JustifyContent="JustifyContent.Center"
                                         AlignItems="AlignItems.Center"
                                         Gap="0.5rem">

                                <RadzenLink Text="Edit"
                                            Icon="edit"
                                            Path="@($"/payments/edit/{payment.PaymentId}")" />

                                <RadzenButton Icon="delete"
                                              Title="Delete payment"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Click="@(_ => DeletePayment(payment))" />

                            </RadzenStack>

                        </Template>

                    </RadzenDataGridColumn>

                </Columns>

            </RadzenDataGrid>

        </RadzenCard>
    }

</RadzenStack>


@code
{
    // =====================================================
    // PAGE STATE
    // =====================================================

    private bool isLoading = true;

    private string? loadErrorMessage;

    private string? operationErrorMessage;

    private string? actionMessage;

    private List<PaymentDisplayItem> payments = new();

    private int totalPayments;

    private string totalReceived = "£0";


    // =====================================================
    // INITIAL LOAD
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadPaymentsAsync();
    }


    // =====================================================
    // LOAD PAYMENTS
    // =====================================================

    private async Task LoadPaymentsAsync()
    {
        isLoading = true;

        loadErrorMessage = null;

        operationErrorMessage = null;

        actionMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // -------------------------------------------------
            // LOAD PAYMENTS
            // -------------------------------------------------

            var paymentRecords =
                await db.Payments
                    .AsNoTracking()
                    .ToListAsync();


            // -------------------------------------------------
            // LOAD LEASES
            // -------------------------------------------------

            var leaseRecords =
                await db.Leases
                    .AsNoTracking()
                    .ToListAsync();


            // -------------------------------------------------
            // LOAD PROPERTIES
            // -------------------------------------------------

            var propertyRecords =
                await db.Properties
                    .AsNoTracking()
                    .ToListAsync();


            // -------------------------------------------------
            // LOAD TENANTS
            // -------------------------------------------------

            var tenantRecords =
                await db.Tenants
                    .AsNoTracking()
                    .ToListAsync();


            // -------------------------------------------------
            // CREATE LOOKUPS
            // -------------------------------------------------

            var leaseLookup =
                leaseRecords.ToDictionary(
                    lease =>
                        lease.LeaseId);


            var propertyLookup =
                propertyRecords.ToDictionary(
                    property =>
                        property.PropertyId,
                    property =>
                        property.Address);


            var tenantLookup =
                tenantRecords.ToDictionary(
                    tenant =>
                        tenant.TenantId,
                    tenant =>
                        $"{tenant.FirstName} {tenant.LastName}");


            // -------------------------------------------------
            // CREATE DISPLAY RECORDS
            // -------------------------------------------------

            payments =
                paymentRecords
                    .Select(
                        payment =>
                        {
                            string propertyName =
                                "Unknown Property";

                            string tenantName =
                                "Unknown Tenant";


                            // -----------------------------------------
                            // FIND LEASE FOR PAYMENT
                            // -----------------------------------------

                            if (payment.LeaseId.HasValue &&
                                leaseLookup.TryGetValue(
                                    payment.LeaseId.Value,
                                    out var lease))
                            {
                                // -------------------------------------
                                // FIND PROPERTY
                                // -------------------------------------

                                if (lease.PropertyId.HasValue &&
                                    propertyLookup.TryGetValue(
                                        lease.PropertyId.Value,
                                        out var propertyAddress))
                                {
                                    propertyName =
                                        propertyAddress;
                                }


                                // -------------------------------------
                                // FIND TENANT
                                // -------------------------------------

                                if (lease.TenantId.HasValue &&
                                    tenantLookup.TryGetValue(
                                        lease.TenantId.Value,
                                        out var foundTenant))
                                {
                                    tenantName =
                                        foundTenant;
                                }
                            }


                            return new PaymentDisplayItem
                            {
                                PaymentId =
                                    payment.PaymentId,

                                Property =
                                    propertyName,

                                Tenant =
                                    tenantName,

                                PaymentDate =
                                    payment.PaymentDate
                                        .ToString("dd MMM yyyy"),

                                Amount =
                                    string.Format(
                                        CultureInfo.GetCultureInfo("en-GB"),
                                        "{0:C}",
                                        payment.Amount),

                                PaymentMethod =
                                    payment.PaymentMethod
                                    ?? "Not Specified"
                            };
                        })
                    .OrderByDescending(
                        payment =>
                            payment.PaymentId)
                    .ToList();


            // -------------------------------------------------
            // SUMMARY INFORMATION
            // -------------------------------------------------

            totalPayments =
                paymentRecords.Count;


            var receivedAmount =
                paymentRecords.Sum(
                    payment =>
                        payment.Amount);


            totalReceived =
                string.Format(
                    CultureInfo.GetCultureInfo("en-GB"),
                    "{0:C}",
                    receivedAmount);
        }
        catch (Exception ex)
        {
            loadErrorMessage =
                "The payment records could not be loaded. Please try again.";


            Console.WriteLine(
                $"Error loading payments: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }


    // =====================================================
    // DELETE PAYMENT
    // =====================================================

    private async Task DeletePayment(
        PaymentDisplayItem payment)
    {
        actionMessage = null;

        operationErrorMessage = null;


        try
        {
            // -------------------------------------------------
            // CONFIRM DELETE
            // -------------------------------------------------

            var confirmed =
                await JS.InvokeAsync<bool>(
                    "confirm",
                    $"Are you sure you want to delete Payment #{payment.PaymentId}?");


            if (!confirmed)
            {
                return;
            }


            await using var db =
                await DbFactory.CreateDbContextAsync();


            // -------------------------------------------------
            // LOAD PAYMENT FROM DATABASE
            // -------------------------------------------------

            var paymentToDelete =
                await db.Payments
                    .FirstOrDefaultAsync(
                        item =>
                            item.PaymentId ==
                            payment.PaymentId);


            if (paymentToDelete == null)
            {
                actionMessage =
                    "The payment could not be found.";

                return;
            }


            // -------------------------------------------------
            // ATTEMPT DELETE
            // -------------------------------------------------

            // If the database has protected audit/history
            // records referencing this payment, MySQL will
            // reject the deletion and the DbUpdateException
            // handler below will protect the history.

            db.Payments.Remove(
                paymentToDelete);


            await db.SaveChangesAsync();


            // -------------------------------------------------
            // UPDATE VISIBLE TABLE
            // -------------------------------------------------

            payments.Remove(
                payment);


            // -------------------------------------------------
            // RECALCULATE PAYMENT COUNT
            // -------------------------------------------------

            totalPayments =
                payments.Count;


            // -------------------------------------------------
            // RECALCULATE TOTAL RECEIVED FROM MYSQL
            // -------------------------------------------------

            var receivedAmount =
                await db.Payments
                    .Select(
                        item =>
                            (decimal?)item.Amount)
                    .SumAsync()
                    ?? 0m;


            totalReceived =
                string.Format(
                    CultureInfo.GetCultureInfo("en-GB"),
                    "{0:C}",
                    receivedAmount);


            actionMessage =
                $"Payment #{payment.PaymentId} deleted successfully.";
        }
        catch (DbUpdateException ex)
        {
            actionMessage =
                "This payment cannot be deleted because it has protected audit or related history.";


            Console.WriteLine(
                $"Protected payment delete prevented for Payment #{payment.PaymentId}: {ex}");
        }
        catch (Exception ex)
        {
            operationErrorMessage =
                "The payment could not be deleted. Please try again.";


            Console.WriteLine(
                $"Error deleting payment {payment.PaymentId}: {ex}");
        }
    }


    // =====================================================
    // DISPLAY MODEL
    // =====================================================

    private sealed class PaymentDisplayItem
    {
        public int PaymentId { get; set; }

        public string Property { get; set; } = "";

        public string Tenant { get; set; } = "";

        public string PaymentDate { get; set; } = "";

        public string Amount { get; set; } = "";

        public string PaymentMethod { get; set; } = "";
    }
}


<style>

    /* =====================================================
           LOAD ERROR
           ===================================================== */

    .management-load-error-card {
        width: 100%;
        border-left: 4px solid #b91c1c;
    }

        .management-load-error-card .rz-icon {
            flex-shrink: 0;
            color: #b91c1c;
        }

    .management-load-error-content {
        min-width: 0;
        flex: 1;
    }

    .management-load-error-title {
        color: #991b1b;
        font-size: 0.95rem;
        font-weight: 700;
    }

    .management-load-error-description {
        margin-top: 0.25rem;
        color: #6b7280;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .management-load-error-retry {
        margin-top: 1rem;
    }


    /* =====================================================
           OPERATION ERROR
           ===================================================== */

    .management-operation-error-card {
        width: 100%;
        color: #991b1b;
        border-left: 4px solid #b91c1c;
    }

        .management-operation-error-card .rz-icon {
            flex-shrink: 0;
            color: #b91c1c;
        }


    /* =====================================================
           MOBILE
           ===================================================== */

    @@media (max-width: 768px) {

        .management-load-error-retry {
            width: 100%;
        }
    }

</style>