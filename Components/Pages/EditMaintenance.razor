@page "/maintenance/edit/{RequestId:int}"

@using Microsoft.EntityFrameworkCore
@using MetDashboard.Data
@using MetDashboard.Data.Models

@inject IDbContextFactory<RealEstateDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Edit Maintenance Request</PageTitle>

<RadzenStack Gap="1.5rem"
             class="form-page">


    <!-- =====================================================
         BACK LINK
         ===================================================== -->

    <div>

        <RadzenLink Text="Back to Maintenance"
                    Icon="arrow_back"
                    Path="/maintenance"
                    class="form-back-link" />

    </div>


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div>

        <div class="management-page-eyebrow">
            MAINTENANCE MANAGEMENT
        </div>

        <RadzenText TextStyle="TextStyle.H3"
                    Style="margin:0;">
            Edit Maintenance Request
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Body1"
                    Style="margin-top:0.35rem;">
            Update the selected maintenance request.
        </RadzenText>

    </div>


    <!-- =====================================================
         LOADING / ERROR
         ===================================================== -->
    @if (isLoading)
    {
        <RadzenCard class="form-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                           Size="ProgressBarCircularSize.Small" />

                <RadzenText>
                    Loading maintenance request...
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }
    else if (!string.IsNullOrEmpty(loadErrorMessage))
    {
        <RadzenCard class="form-error-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenIcon Icon="error"
                            Style="font-size:1.25rem;" />

                <RadzenText>
                    @loadErrorMessage
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }
    else if (model != null)
    {

        @if (!string.IsNullOrEmpty(saveErrorMessage))
        {
            <RadzenCard class="form-error-card">

                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0.75rem">

                    <RadzenIcon Icon="error"
                                Style="font-size:1.25rem;" />

                    <RadzenText>
                        @saveErrorMessage
                    </RadzenText>

                </RadzenStack>

            </RadzenCard>
        }


        <!-- =================================================
             FORM
             ================================================= -->

        <RadzenCard class="form-card">

            <div class="form-card-header">

                <div>

                    <RadzenText TextStyle="TextStyle.H6"
                                Style="margin:0;">
                        Maintenance Details
                    </RadzenText>

                    <div class="form-card-description">
                        Update the property, tenant, assignment, status and maintenance information.
                    </div>

                </div>

            </div>


            <div class="form-card-body">

                <RadzenTemplateForm TItem="EditMaintenanceModel"
                                    Data="@model"
                                    Submit="@SaveRequest">

                    <RadzenStack Gap="1.5rem">


                        <!-- =====================================
                             PROPERTY / TENANT
                             ===================================== -->

                        <div class="form-grid">

                            <div class="form-field">

                                <label class="form-label">
                                    Property
                                    <span class="form-required">*</span>
                                </label>

                                <RadzenDropDown TValue="int?"
                                                Name="PropertyId"
                                                Data="@propertyOptions"
                                                TextProperty="DisplayName"
                                                ValueProperty="PropertyId"
                                                @bind-Value="@model.PropertyId"
                                                @bind-Value:after="FilterTenantsForSelectedProperty"
                                                Placeholder="Select a property"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Style="width:100%;" />

                                <RadzenRequiredValidator Component="PropertyId"
                                                         Text="Please select a property." />

                            </div>


                            <div class="form-field">

                                <label class="form-label">
                                    Tenant
                                </label>

                                <RadzenDropDown TValue="int?"
                                                Data="@tenantOptions"
                                                TextProperty="DisplayName"
                                                ValueProperty="TenantId"
                                                @bind-Value="@model.TenantId"
                                                Placeholder="@TenantPlaceholder"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Disabled="@(!model.PropertyId.HasValue || tenantOptions.Count == 0)"
                                                Style="width:100%;" />


                                @if (model.PropertyId.HasValue &&
                                     tenantOptions.Count == 0)
                                {
                                    <div class="form-field-hint">
                                        This property does not currently have a tenant with an active lease.
                                        The maintenance request can still be saved without a tenant.
                                    </div>
                                }
                                else
                                {
                                    <div class="form-field-hint">
                                        Only tenants with an active lease for the selected property are shown.
                                    </div>
                                }

                            </div>

                        </div>


                        <!-- =====================================
                             EMPLOYEE / REQUEST DATE
                             ===================================== -->

                        <div class="form-grid">

                            <div class="form-field">

                                <label class="form-label">
                                    Assigned Employee
                                </label>

                                <RadzenDropDown TValue="int?"
                                                Data="@employeeOptions"
                                                TextProperty="DisplayName"
                                                ValueProperty="EmployeeId"
                                                @bind-Value="@model.EmployeeId"
                                                Placeholder="Select employee (optional)"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Style="width:100%;" />

                                <div class="form-field-hint">
                                    Optional. Select the employee responsible for this request.
                                </div>

                            </div>


                            <div class="form-field">

                                <label class="form-label">
                                    Request Date
                                    <span class="form-required">*</span>
                                </label>

                                <RadzenDatePicker TValue="DateTime?"
                                                  Name="RequestDate"
                                                  @bind-Value="@model.RequestDate"
                                                  DateFormat="dd/MM/yyyy"
                                                  Style="width:100%;" />

                                <RadzenRequiredValidator Component="RequestDate"
                                                         Text="Request date is required." />

                            </div>

                        </div>


                        <!-- =====================================
                             DESCRIPTION
                             ===================================== -->

                        <div class="form-field">

                            <label class="form-label">
                                Description
                                <span class="form-required">*</span>
                            </label>

                            <RadzenTextArea Name="Description"
                                            @bind-Value="@model.Description"
                                            Placeholder="Describe the maintenance issue"
                                            Rows="5"
                                            Style="width:100%;" />

                            <RadzenRequiredValidator Component="Description"
                                                     Text="Maintenance description is required." />

                            <div class="form-field-hint">
                                Keep the description updated with the current details of the maintenance issue.
                            </div>

                        </div>


                        <!-- =====================================
                             STATUS / COMPLETION DATE
                             ===================================== -->

                        <div class="form-grid">

                            <div class="form-field">

                                <label class="form-label">
                                    Status
                                </label>

                                <RadzenDropDown TValue="string"
                                                Data="@statuses"
                                                @bind-Value="@model.Status"
                                                Style="width:100%;" />

                                <div class="form-field-hint">
                                    Choose Open, In Progress or Completed.
                                </div>

                            </div>


                            <div class="form-field">

                                <label class="form-label">

                                    Completion Date

                                    @if (model.Status == "Completed")
                                    {
                                        <span class="form-required">*</span>
                                    }

                                </label>

                                <RadzenDatePicker TValue="DateTime?"
                                                  @bind-Value="@model.CompletionDate"
                                                  DateFormat="dd/MM/yyyy"
                                                  AllowClear="true"
                                                  Style="width:100%;" />


                                @if (model.Status == "Completed")
                                {
                                    <div class="form-field-hint">
                                        A completion date is required when the request is Completed.
                                    </div>
                                }
                                else
                                {
                                    <div class="form-field-hint">
                                        Completion date must be blank while the request is Open or In Progress.
                                    </div>
                                }

                            </div>

                        </div>


                        <!-- =====================================
                             COST
                             ===================================== -->

                        <div class="form-field">

                            <label class="form-label">
                                Cost
                            </label>

                            <RadzenNumeric TValue="decimal?"
                                           @bind-Value="@model.Cost"
                                           Min="@(0m)"
                                           Step="0.01"
                                           Placeholder="Enter maintenance cost"
                                           Style="width:100%;" />

                            <div class="form-field-hint">
                                Enter the current or final maintenance cost if known.
                            </div>

                        </div>


                        <!-- =====================================
                             FORM ACTIONS
                             ===================================== -->

                        <div class="form-actions">

                            <RadzenButton Text="Cancel"
                                          Icon="close"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@Cancel" />

                            <RadzenButton Text="Save Changes"
                                          Icon="save"
                                          ButtonType="ButtonType.Submit"
                                          Disabled="@isSaving" />

                        </div>


                        @if (isSaving)
                        {
                            <div class="form-saving-message">

                                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                                           Size="ProgressBarCircularSize.Small" />

                                <RadzenText>
                                    Saving maintenance changes...
                                </RadzenText>

                            </div>
                        }

                    </RadzenStack>

                </RadzenTemplateForm>

            </div>

        </RadzenCard>
    }

</RadzenStack>


@code
{
    [Parameter]
    public int RequestId { get; set; }


    private EditMaintenanceModel? model;

    private bool isLoading = true;

    private bool isSaving;

    private string? loadErrorMessage;

    private string? saveErrorMessage;


    private List<PropertyOption> propertyOptions = new();


    // Keep the complete tenant list internally.
    private List<TenantOption> allTenantOptions = new();


    // Only tenants that belong to the selected property
    // through an Active lease are displayed.
    private List<TenantOption> tenantOptions = new();


    private List<EmployeeOption> employeeOptions = new();


    // Stores active Property -> Tenant lease relationships.
    private List<LeaseTenantLink> activeLeaseTenantLinks = new();


    private readonly List<string> statuses =
    [
        "Open",
        "In Progress",
        "Completed"
    ];


    private string TenantPlaceholder
    {
        get
        {
            if (model == null ||
                !model.PropertyId.HasValue)
            {
                return "Select a property first";
            }


            if (tenantOptions.Count == 0)
            {
                return "No active tenant for this property";
            }


            return "Select tenant (optional)";
        }
    }


    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadErrorMessage = null;

        saveErrorMessage = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // Load maintenance request.
            var request =
                await db.Set<Maintenancerequest>()
                    .AsNoTracking()
                    .FirstOrDefaultAsync(
                        item =>
                            item.RequestId == RequestId);


            if (request == null)
            {
                loadErrorMessage =
                    "The requested maintenance record could not be found.";

                return;
            }


            // Load properties.
            propertyOptions =
                await db.Properties
                    .AsNoTracking()
                    .OrderBy(property =>
                        property.Address)
                    .Select(property =>
                        new PropertyOption
                        {
                            PropertyId =
                                property.PropertyId,

                            DisplayName =
                                property.Address +
                                ", " +
                                property.City
                        })
                    .ToListAsync();


            // Load all tenants.
            //
            // They are kept internally and filtered after
            // the selected property is known.
            allTenantOptions =
                await db.Tenants
                    .AsNoTracking()
                    .OrderBy(tenant =>
                        tenant.LastName)
                    .ThenBy(tenant =>
                        tenant.FirstName)
                    .Select(tenant =>
                        new TenantOption
                        {
                            TenantId =
                                tenant.TenantId,

                            DisplayName =
                                tenant.FirstName +
                                " " +
                                tenant.LastName
                        })
                    .ToListAsync();


            // Load active leases used to determine which
            // tenant belongs to which property.
            var activeLeases =
                await db.Leases
                    .AsNoTracking()
                    .Where(lease =>
                        lease.LeaseStatus == "Active")
                    .ToListAsync();


            activeLeaseTenantLinks =
                activeLeases
                    .Where(lease =>
                        lease.PropertyId.HasValue &&
                        lease.TenantId.HasValue)
                    .Select(lease =>
                        new LeaseTenantLink
                        {
                            PropertyId =
                                lease.PropertyId!.Value,

                            TenantId =
                                lease.TenantId!.Value
                        })
                    .ToList();


            // Load employees.
            employeeOptions =
                await db.Employees
                    .AsNoTracking()
                    .OrderBy(employee =>
                        employee.LastName)
                    .ThenBy(employee =>
                        employee.FirstName)
                    .Select(employee =>
                        new EmployeeOption
                        {
                            EmployeeId =
                                employee.EmployeeId,

                            DisplayName =
                                employee.FirstName +
                                " " +
                                employee.LastName
                        })
                    .ToListAsync();


            // Populate form with existing values.
            model =
                new EditMaintenanceModel
                {
                    PropertyId =
                        request.PropertyId,

                    TenantId =
                        request.TenantId,

                    EmployeeId =
                        request.EmployeeId,

                    Description =
                        request.Description,

                    RequestDate =
                        request.RequestDate,

                    CompletionDate =
                        request.CompletionDate,

                    Status =
                        request.Status ?? "Open",

                    Cost =
                        request.Cost
                };


            // Filter the tenant list for the existing
            // property without clearing the existing tenant.
            RefreshTenantOptions(
                clearSelectedTenant: false);
        }
        catch (Exception ex)
        {
            loadErrorMessage =
                "The selected maintenance request could not be loaded. Please return to the maintenance page and try again.";

            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }


    // ==============================================
    // PROPERTY / TENANT FILTERING
    // ==============================================

    private Task FilterTenantsForSelectedProperty()
    {
        // When the user changes property, the previous
        // tenant must not remain selected.
        RefreshTenantOptions(
            clearSelectedTenant: true);


        return Task.CompletedTask;
    }


    private void RefreshTenantOptions(
        bool clearSelectedTenant)
    {
        if (model == null)
        {
            tenantOptions =
                new List<TenantOption>();

            return;
        }


        if (clearSelectedTenant)
        {
            model.TenantId =
                null;
        }


        if (!model.PropertyId.HasValue)
        {
            tenantOptions =
                new List<TenantOption>();

            return;
        }


        // Find tenants with an Active lease
        // for the selected property.
        var validTenantIds =
            activeLeaseTenantLinks
                .Where(link =>
                    link.PropertyId ==
                    model.PropertyId.Value)
                .Select(link =>
                    link.TenantId)
                .ToHashSet();


        tenantOptions =
            allTenantOptions
                .Where(tenant =>
                    validTenantIds.Contains(
                        tenant.TenantId))
                .ToList();


        // When loading an existing record, keep its
        // tenant only if that tenant is still valid
        // for the selected property.
        if (!clearSelectedTenant &&
            model.TenantId.HasValue &&
            !validTenantIds.Contains(
                model.TenantId.Value))
        {
            model.TenantId =
                null;
        }
    }


    private async Task SaveRequest(
        EditMaintenanceModel value)
    {
        if (isSaving)
        {
            return;
        }


        try
        {
            isSaving = true;

            saveErrorMessage = null;


            if (!value.PropertyId.HasValue)
            {
                saveErrorMessage =
                    "Please select a property.";

                return;
            }


            if (string.IsNullOrWhiteSpace(
                value.Description))
            {
                saveErrorMessage =
                    "Maintenance description is required.";

                return;
            }


            if (!value.RequestDate.HasValue)
            {
                saveErrorMessage =
                    "Request date is required.";

                return;
            }


            // ==============================================
            // STATUS VALIDATION
            // ==============================================

            if (value.Status != "Open" &&
                value.Status != "In Progress" &&
                value.Status != "Completed")
            {
                saveErrorMessage =
                    "Please select a valid maintenance status.";

                return;
            }


            // ==============================================
            // STATUS / COMPLETION DATE CONSISTENCY
            // ==============================================

            // A completed request must have a completion date.
            if (value.Status == "Completed" &&
                !value.CompletionDate.HasValue)
            {
                saveErrorMessage =
                    "A completion date is required when the maintenance request is completed.";

                return;
            }


            // Open and In Progress requests must not
            // have a completion date.
            if ((value.Status == "Open" ||
                 value.Status == "In Progress") &&
                value.CompletionDate.HasValue)
            {
                saveErrorMessage =
                    "Completion date must be blank while the maintenance request is Open or In Progress.";

                return;
            }


            // Completion date cannot be before request date.
            if (value.CompletionDate.HasValue &&
                value.CompletionDate.Value.Date <
                value.RequestDate.Value.Date)
            {
                saveErrorMessage =
                    "Completion date cannot be before the request date.";

                return;
            }


            if (value.Cost.HasValue &&
                value.Cost.Value < 0)
            {
                saveErrorMessage =
                    "Maintenance cost cannot be negative.";

                return;
            }


            await using var db =
                await DbFactory.CreateDbContextAsync();


            // Confirm property still exists.
            var propertyExists =
                await db.Properties.AnyAsync(
                    property =>
                        property.PropertyId ==
                        value.PropertyId.Value);


            if (!propertyExists)
            {
                saveErrorMessage =
                    "The selected property could not be found.";

                return;
            }


            // ==============================================
            // TENANT / PROPERTY BUSINESS VALIDATION
            // ==============================================

            if (value.TenantId.HasValue)
            {
                // Confirm tenant still exists.
                var tenantExists =
                    await db.Tenants.AnyAsync(
                        tenant =>
                            tenant.TenantId ==
                            value.TenantId.Value);


                if (!tenantExists)
                {
                    saveErrorMessage =
                        "The selected tenant could not be found.";

                    return;
                }


                // Confirm the selected tenant actually has
                // an Active lease for the selected property.
                //
                // This server-side check protects the data
                // even if the UI filtering is bypassed.
                var tenantBelongsToProperty =
                    await db.Leases.AnyAsync(
                        lease =>
                            lease.PropertyId.HasValue &&

                            lease.PropertyId.Value ==
                                value.PropertyId.Value &&

                            lease.TenantId.HasValue &&

                            lease.TenantId.Value ==
                                value.TenantId.Value &&

                            lease.LeaseStatus ==
                                "Active");


                if (!tenantBelongsToProperty)
                {
                    saveErrorMessage =
                        "The selected tenant does not have an active lease for this property.";

                    return;
                }
            }


            // Confirm employee exists if selected.
            if (value.EmployeeId.HasValue)
            {
                var employeeExists =
                    await db.Employees.AnyAsync(
                        employee =>
                            employee.EmployeeId ==
                            value.EmployeeId.Value);


                if (!employeeExists)
                {
                    saveErrorMessage =
                        "The selected employee could not be found.";

                    return;
                }
            }


            // Load tracked maintenance request.
            var request =
                await db.Set<Maintenancerequest>()
                    .FirstOrDefaultAsync(
                        item =>
                            item.RequestId == RequestId);


            if (request == null)
            {
                saveErrorMessage =
                    "The maintenance request could not be found.";

                return;
            }


            // Apply changes.
            request.PropertyId =
                value.PropertyId.Value;

            request.TenantId =
                value.TenantId;

            request.EmployeeId =
                value.EmployeeId;

            request.Description =
                value.Description.Trim();

            request.RequestDate =
                value.RequestDate.Value;

            request.Status =
                value.Status;

            request.Cost =
                value.Cost;

            request.CompletionDate =
                value.CompletionDate;


            await db.SaveChangesAsync();


            Navigation.NavigateTo(
                "/maintenance");
        }
        catch (Exception ex)
        {
            saveErrorMessage =
                "The maintenance changes could not be saved. Please try again.";

            Console.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo(
            "/maintenance");
    }


    private sealed class EditMaintenanceModel
    {
        public int? PropertyId { get; set; }

        public int? TenantId { get; set; }

        public int? EmployeeId { get; set; }

        public string Description { get; set; } = "";

        public DateTime? RequestDate { get; set; }

        public DateTime? CompletionDate { get; set; }

        public string Status { get; set; } =
            "Open";

        public decimal? Cost { get; set; }
    }


    private sealed class PropertyOption
    {
        public int PropertyId { get; set; }

        public string DisplayName { get; set; } = "";
    }


    private sealed class TenantOption
    {
        public int TenantId { get; set; }

        public string DisplayName { get; set; } = "";
    }


    private sealed class EmployeeOption
    {
        public int EmployeeId { get; set; }

        public string DisplayName { get; set; } = "";
    }


    private sealed class LeaseTenantLink
    {
        public int PropertyId { get; set; }

        public int TenantId { get; set; }
    }
}