@page "/owners/edit/{OwnerId:int}"

@using Microsoft.EntityFrameworkCore
@using MetDashboard.Data
@using MetDashboard.Data.Models

@inject IDbContextFactory<RealEstateDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Edit Owner</PageTitle>

<RadzenStack Gap="1.5rem"
             class="form-page">


    <!-- =====================================================
         BACK LINK
         ===================================================== -->

    <div>

        <RadzenLink Text="Back to Owners"
                    Icon="arrow_back"
                    Path="/owners"
                    class="form-back-link" />

    </div>


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div>

        <div class="management-page-eyebrow">
            OWNERSHIP MANAGEMENT
        </div>

        <RadzenText TextStyle="TextStyle.H3"
                    Style="margin:0;">
            Edit Owner
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Body1"
                    Style="margin-top:0.35rem;">
            Update the selected property owner's details.
        </RadzenText>

    </div>


    <!-- =====================================================
         LOADING / ERROR
         ===================================================== -->
    @if (isLoading)
    {
        <RadzenCard class="form-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                           Size="ProgressBarCircularSize.Small" />

                <RadzenText>
                    Loading owner...
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }
    else if (!string.IsNullOrEmpty(loadErrorMessage))
    {
        <RadzenCard class="form-error-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenIcon Icon="error"
                            Style="font-size:1.25rem;" />

                <RadzenText>
                    @loadErrorMessage
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }
    else if (model != null)
    {

        @if (!string.IsNullOrEmpty(saveErrorMessage))
        {
            <RadzenCard class="form-error-card">

                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0.75rem">

                    <RadzenIcon Icon="error"
                                Style="font-size:1.25rem;" />

                    <RadzenText>
                        @saveErrorMessage
                    </RadzenText>

                </RadzenStack>

            </RadzenCard>
        }


        <!-- =================================================
             FORM
             ================================================= -->

        <RadzenCard class="form-card">

            <div class="form-card-header">

                <div>

                    <RadzenText TextStyle="TextStyle.H6"
                                Style="margin:0;">
                        Owner Details
                    </RadzenText>

                    <div class="form-card-description">
                        Update the owner's personal, contact and mailing information.
                    </div>

                </div>

            </div>


            <div class="form-card-body">

                <RadzenTemplateForm TItem="EditOwnerModel"
                                    Data="@model"
                                    Submit="@SaveOwner">

                    <RadzenStack Gap="1.5rem">


                        <!-- =====================================
                             FIRST NAME / LAST NAME
                             ===================================== -->

                        <div class="form-grid">

                            <div class="form-field">

                                <label class="form-label">
                                    First Name
                                    <span class="form-required">*</span>
                                </label>

                                <RadzenTextBox Name="FirstName"
                                               @bind-Value="@model.FirstName"
                                               Placeholder="Enter first name"
                                               Style="width:100%;" />

                                <RadzenRequiredValidator Component="FirstName"
                                                         Text="First name is required." />

                            </div>


                            <div class="form-field">

                                <label class="form-label">
                                    Last Name
                                    <span class="form-required">*</span>
                                </label>

                                <RadzenTextBox Name="LastName"
                                               @bind-Value="@model.LastName"
                                               Placeholder="Enter last name"
                                               Style="width:100%;" />

                                <RadzenRequiredValidator Component="LastName"
                                                         Text="Last name is required." />

                            </div>

                        </div>


                        <!-- =====================================
                             EMAIL / PHONE
                             ===================================== -->

                        <div class="form-grid">

                            <div class="form-field">

                                <label class="form-label">
                                    Email
                                </label>

                                <RadzenTextBox Name="Email"
                                               @bind-Value="@model.Email"
                                               Placeholder="e.g. owner@example.com"
                                               Style="width:100%;" />

                                <RadzenEmailValidator Component="Email"
                                                      Text="Please enter a valid email address." />

                            </div>


                            <div class="form-field">

                                <label class="form-label">
                                    Phone
                                </label>

                                <RadzenTextBox @bind-Value="@model.Phone"
                                               Placeholder="e.g. 07123 456789"
                                               Style="width:100%;" />

                            </div>

                        </div>


                        <!-- =====================================
                             MAILING ADDRESS
                             ===================================== -->

                        <div class="form-field">

                            <label class="form-label">
                                Mailing Address
                            </label>

                            <RadzenTextBox @bind-Value="@model.MailingAddress"
                                           Placeholder="Enter mailing address"
                                           Style="width:100%;" />

                            <div class="form-field-hint">
                                Update the owner's preferred correspondence address if required.
                            </div>

                        </div>


                        <!-- =====================================
                             FORM ACTIONS
                             ===================================== -->

                        <div class="form-actions">

                            <RadzenButton Text="Cancel"
                                          Icon="close"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@Cancel" />

                            <RadzenButton Text="Save Changes"
                                          Icon="save"
                                          ButtonType="ButtonType.Submit"
                                          Disabled="@isSaving" />

                        </div>


                        @if (isSaving)
                        {
                            <div class="form-saving-message">

                                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                                           Size="ProgressBarCircularSize.Small" />

                                <RadzenText>
                                    Saving changes...
                                </RadzenText>

                            </div>
                        }

                    </RadzenStack>

                </RadzenTemplateForm>

            </div>

        </RadzenCard>
    }

</RadzenStack>


@code
{
    [Parameter]
    public int OwnerId { get; set; }


    private EditOwnerModel? model;

    private bool isLoading = true;

    private bool isSaving;

    private string? loadErrorMessage;

    private string? saveErrorMessage;


    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadErrorMessage = null;

        saveErrorMessage = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var owner =
                await db.Owners
                    .AsNoTracking()
                    .FirstOrDefaultAsync(
                        item =>
                            item.OwnerId == OwnerId);


            if (owner == null)
            {
                loadErrorMessage =
                    "The requested owner could not be found.";

                return;
            }


            model =
                new EditOwnerModel
                {
                    FirstName =
                        owner.FirstName,

                    LastName =
                        owner.LastName,

                    Email =
                        owner.Email,

                    Phone =
                        owner.Phone,

                    MailingAddress =
                        owner.MailingAddress
                };
        }
        catch (Exception ex)
        {
            loadErrorMessage =
                "The selected owner could not be loaded. Please return to the owners page and try again.";

            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SaveOwner(
        EditOwnerModel value)
    {
        if (isSaving)
        {
            return;
        }


        try
        {
            isSaving = true;

            saveErrorMessage = null;


            await using var db =
                await DbFactory.CreateDbContextAsync();


            var owner =
                await db.Owners
                    .FirstOrDefaultAsync(
                        item =>
                            item.OwnerId == OwnerId);


            if (owner == null)
            {
                saveErrorMessage =
                    "The owner could not be found.";

                return;
            }


            owner.FirstName =
                value.FirstName.Trim();

            owner.LastName =
                value.LastName.Trim();

            owner.Email =
                string.IsNullOrWhiteSpace(value.Email)
                    ? null
                    : value.Email.Trim();

            owner.Phone =
                string.IsNullOrWhiteSpace(value.Phone)
                    ? null
                    : value.Phone.Trim();

            owner.MailingAddress =
                string.IsNullOrWhiteSpace(value.MailingAddress)
                    ? null
                    : value.MailingAddress.Trim();


            await db.SaveChangesAsync();


            Navigation.NavigateTo("/owners");
        }
        catch (Exception ex)
        {
            saveErrorMessage =
                "The owner changes could not be saved. Please try again.";

            Console.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo("/owners");
    }


    private sealed class EditOwnerModel
    {
        public string FirstName { get; set; } = "";

        public string LastName { get; set; } = "";

        public string? Email { get; set; }

        public string? Phone { get; set; }

        public string? MailingAddress { get; set; }
    }
}