@page "/tenants"

@using Microsoft.EntityFrameworkCore
@using MetDashboard.Data
@using MetDashboard.Data.Models

@inject IDbContextFactory<RealEstateDbContext> DbFactory
@inject Microsoft.JSInterop.IJSRuntime JS


<PageTitle>Tenants</PageTitle>

<RadzenStack Gap="1.5rem">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="management-page-header">

        <div>

            <div class="management-page-eyebrow">
                TENANT MANAGEMENT
            </div>

            <RadzenText TextStyle="TextStyle.H3"
                        Style="margin:0;">
                Tenants
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Body1"
                        Style="margin-top:0.35rem;">
                View and manage registered tenants.
            </RadzenText>

        </div>


        <div class="management-page-actions">

            <RadzenLink Text="Add Tenant"
                        Icon="person_add"
                        Path="/tenants/add" />

        </div>

    </div>


    <!-- =====================================================
         ACTION MESSAGE
         ===================================================== -->
    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <RadzenCard class="management-message-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenIcon Icon="info"
                            Style="font-size:1.25rem;" />

                <RadzenText>
                    @actionMessage
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }


    <!-- =====================================================
         OPERATION ERROR
         ===================================================== -->
    @if (!string.IsNullOrEmpty(operationErrorMessage))
    {
        <RadzenCard class="management-operation-error-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenIcon Icon="error"
                            Style="font-size:1.25rem;" />

                <RadzenText>
                    @operationErrorMessage
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }


    <!-- =====================================================
         LOADING / LOAD ERROR
         ===================================================== -->
    @if (isLoading)
    {
        <RadzenCard>

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                           Size="ProgressBarCircularSize.Small" />

                <RadzenText>
                    Loading tenants...
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }
    else if (!string.IsNullOrEmpty(loadErrorMessage))
    {
        <RadzenCard class="management-load-error-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Start"
                         Gap="1rem">

                <RadzenIcon Icon="error"
                            Style="font-size:1.5rem;" />


                <div class="management-load-error-content">

                    <div class="management-load-error-title">
                        Unable to load tenants
                    </div>

                    <div class="management-load-error-description">
                        @loadErrorMessage
                    </div>


                    <RadzenButton Text="Retry"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@(_ => LoadTenantsAsync())"
                                  class="management-load-error-retry" />

                </div>

            </RadzenStack>

        </RadzenCard>
    }
    else
    {
        <!-- =================================================
             GRID CARD
             ================================================= -->

        <RadzenCard class="management-grid-card">

            <div class="management-grid-header">

                <div>

                    <RadzenText TextStyle="TextStyle.H6"
                                Style="margin:0;">
                        Tenant Directory
                    </RadzenText>

                    <div class="management-grid-summary">
                        @tenants.Count @(tenants.Count == 1 ? "tenant" : "tenants") registered
                    </div>

                </div>

            </div>


            <RadzenDataGrid TItem="Tenant"
                            Data="@tenants"
                            AllowPaging="true"
                            PageSize="10"
                            AllowSorting="true"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            class="management-grid"
                            Style="width:100%;">

                <Columns>

                    <RadzenDataGridColumn TItem="Tenant"
                                          Property="TenantId"
                                          Title="ID"
                                          Width="75px" />


                    <RadzenDataGridColumn TItem="Tenant"
                                          Property="FirstName"
                                          Title="First Name"
                                          Width="150px">

                        <Template Context="tenant">

                            <div class="primary-grid-value">
                                @tenant.FirstName
                            </div>

                        </Template>

                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="Tenant"
                                          Property="LastName"
                                          Title="Last Name"
                                          Width="150px">

                        <Template Context="tenant">

                            <div class="primary-grid-value">
                                @tenant.LastName
                            </div>

                        </Template>

                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="Tenant"
                                          Property="Email"
                                          Title="Email"
                                          Width="240px" />


                    <RadzenDataGridColumn TItem="Tenant"
                                          Property="Phone"
                                          Title="Phone"
                                          Width="150px" />


                    <RadzenDataGridColumn TItem="Tenant"
                                          Property="Employer"
                                          Title="Employer"
                                          Width="180px" />


                    <RadzenDataGridColumn TItem="Tenant"
                                          Title="Actions"
                                          Filterable="false"
                                          Sortable="false"
                                          TextAlign="TextAlign.Center"
                                          Width="160px">

                        <Template Context="tenant">

                            <RadzenStack Orientation="Orientation.Horizontal"
                                         JustifyContent="JustifyContent.Center"
                                         AlignItems="AlignItems.Center"
                                         Gap="0.5rem">

                                <RadzenLink Text="Edit"
                                            Icon="edit"
                                            Path="@($"/tenants/edit/{tenant.TenantId}")" />

                                <RadzenButton Icon="delete"
                                              Title="Delete tenant"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Click="@(_ => DeleteTenant(tenant))" />

                            </RadzenStack>

                        </Template>

                    </RadzenDataGridColumn>

                </Columns>

            </RadzenDataGrid>

        </RadzenCard>
    }

</RadzenStack>


@code
{
    // =====================================================
    // PAGE STATE
    // =====================================================

    private bool isLoading = true;

    private string? loadErrorMessage;

    private string? operationErrorMessage;

    private string? actionMessage;

    private List<Tenant> tenants = new();


    // =====================================================
    // INITIAL LOAD
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
    }


    // =====================================================
    // LOAD TENANTS
    // =====================================================

    private async Task LoadTenantsAsync()
    {
        isLoading = true;

        loadErrorMessage = null;

        operationErrorMessage = null;

        actionMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            tenants =
                await db.Tenants
                    .AsNoTracking()
                    .OrderBy(
                        tenant =>
                            tenant.LastName)
                    .ThenBy(
                        tenant =>
                            tenant.FirstName)
                    .ToListAsync();
        }
        catch (Exception ex)
        {
            loadErrorMessage =
                "The tenant records could not be loaded. Please try again.";


            Console.WriteLine(
                $"Error loading tenants: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }


    // =====================================================
    // DELETE TENANT
    // =====================================================

    private async Task DeleteTenant(Tenant tenant)
    {
        actionMessage = null;

        operationErrorMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // -------------------------------------------------
            // CHECK FOR RELATED LEASES
            // -------------------------------------------------

            var hasLeases =
                await db.Leases.AnyAsync(
                    lease =>
                        lease.TenantId ==
                        tenant.TenantId);


            // -------------------------------------------------
            // CHECK FOR MAINTENANCE RECORDS
            // -------------------------------------------------

            var hasMaintenance =
                await db.Set<Maintenancerequest>()
                    .AnyAsync(
                        request =>
                            request.TenantId ==
                            tenant.TenantId);


            // -------------------------------------------------
            // PROTECT RELATED RECORDS
            // -------------------------------------------------

            if (hasLeases ||
                hasMaintenance)
            {
                actionMessage =
                    "This tenant cannot be deleted because they have related lease or maintenance records.";

                return;
            }


            // -------------------------------------------------
            // CONFIRM DELETE
            // -------------------------------------------------

            var confirmed =
                await JS.InvokeAsync<bool>(
                    "confirm",
                    $"Are you sure you want to delete {tenant.FirstName} {tenant.LastName}?");


            if (!confirmed)
            {
                return;
            }


            // -------------------------------------------------
            // FIND TENANT AGAIN USING THIS CONTEXT
            // -------------------------------------------------

            var tenantToDelete =
                await db.Tenants
                    .FirstOrDefaultAsync(
                        item =>
                            item.TenantId ==
                            tenant.TenantId);


            if (tenantToDelete == null)
            {
                actionMessage =
                    "The tenant could not be found.";

                return;
            }


            // -------------------------------------------------
            // DELETE FROM MYSQL
            // -------------------------------------------------

            db.Tenants.Remove(
                tenantToDelete);


            await db.SaveChangesAsync();


            // -------------------------------------------------
            // UPDATE VISIBLE GRID
            // -------------------------------------------------

            tenants.Remove(
                tenant);


            actionMessage =
                "Tenant deleted successfully.";
        }
        catch (Exception ex)
        {
            operationErrorMessage =
                "The tenant could not be deleted. Please try again.";


            Console.WriteLine(
                $"Error deleting tenant {tenant.TenantId}: {ex}");
        }
    }
}


<style>

    /* =====================================================
           LOAD ERROR
           ===================================================== */

    .management-load-error-card {
        width: 100%;
        border-left: 4px solid #b91c1c;
    }

        .management-load-error-card .rz-icon {
            flex-shrink: 0;
            color: #b91c1c;
        }

    .management-load-error-content {
        min-width: 0;
        flex: 1;
    }

    .management-load-error-title {
        color: #991b1b;
        font-size: 0.95rem;
        font-weight: 700;
    }

    .management-load-error-description {
        margin-top: 0.25rem;
        color: #6b7280;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .management-load-error-retry {
        margin-top: 1rem;
    }


    /* =====================================================
           OPERATION ERROR
           ===================================================== */

    .management-operation-error-card {
        width: 100%;
        color: #991b1b;
        border-left: 4px solid #b91c1c;
    }

        .management-operation-error-card .rz-icon {
            flex-shrink: 0;
            color: #b91c1c;
        }


    /* =====================================================
           MOBILE
           ===================================================== */

    @@media (max-width: 768px) {

        .management-load-error-retry {
            width: 100%;
        }
    }

</style>