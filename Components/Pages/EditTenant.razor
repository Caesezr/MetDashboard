@page "/tenants/edit/{TenantId:int}"

@using Microsoft.EntityFrameworkCore
@using MetDashboard.Data
@using MetDashboard.Data.Models

@inject IDbContextFactory<RealEstateDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Edit Tenant</PageTitle>

<RadzenStack Gap="1.5rem"
             class="form-page">


    <!-- =====================================================
         BACK LINK
         ===================================================== -->

    <div>

        <RadzenLink Text="Back to Tenants"
                    Icon="arrow_back"
                    Path="/tenants"
                    class="form-back-link" />

    </div>


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div>

        <div class="management-page-eyebrow">
            TENANT MANAGEMENT
        </div>

        <RadzenText TextStyle="TextStyle.H3"
                    Style="margin:0;">
            Edit Tenant
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Body1"
                    Style="margin-top:0.35rem;">
            Update the selected tenant's details.
        </RadzenText>

    </div>


    <!-- =====================================================
         LOADING / ERROR
         ===================================================== -->
    @if (isLoading)
    {
        <RadzenCard class="form-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                           Size="ProgressBarCircularSize.Small" />

                <RadzenText>
                    Loading tenant...
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }
    else if (!string.IsNullOrEmpty(loadErrorMessage))
    {
        <RadzenCard class="form-error-card">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.75rem">

                <RadzenIcon Icon="error"
                            Style="font-size:1.25rem;" />

                <RadzenText>
                    @loadErrorMessage
                </RadzenText>

            </RadzenStack>

        </RadzenCard>
    }
    else if (model != null)
    {

        @if (!string.IsNullOrEmpty(saveErrorMessage))
        {
            <RadzenCard class="form-error-card">

                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0.75rem">

                    <RadzenIcon Icon="error"
                                Style="font-size:1.25rem;" />

                    <RadzenText>
                        @saveErrorMessage
                    </RadzenText>

                </RadzenStack>

            </RadzenCard>
        }


        <!-- =================================================
             FORM
             ================================================= -->

        <RadzenCard class="form-card">

            <div class="form-card-header">

                <div>

                    <RadzenText TextStyle="TextStyle.H6"
                                Style="margin:0;">
                        Tenant Details
                    </RadzenText>

                    <div class="form-card-description">
                        Update the tenant's personal, contact and employment information.
                    </div>

                </div>

            </div>


            <div class="form-card-body">

                <RadzenTemplateForm TItem="EditTenantModel"
                                    Data="@model"
                                    Submit="@SaveTenant">

                    <RadzenStack Gap="1.5rem">


                        <!-- =====================================
                             FIRST NAME / LAST NAME
                             ===================================== -->

                        <div class="form-grid">

                            <div class="form-field">

                                <label class="form-label">
                                    First Name
                                    <span class="form-required">*</span>
                                </label>

                                <RadzenTextBox Name="FirstName"
                                               @bind-Value="@model.FirstName"
                                               Placeholder="Enter first name"
                                               Style="width:100%;" />

                                <RadzenRequiredValidator Component="FirstName"
                                                         Text="First name is required." />

                            </div>


                            <div class="form-field">

                                <label class="form-label">
                                    Last Name
                                    <span class="form-required">*</span>
                                </label>

                                <RadzenTextBox Name="LastName"
                                               @bind-Value="@model.LastName"
                                               Placeholder="Enter last name"
                                               Style="width:100%;" />

                                <RadzenRequiredValidator Component="LastName"
                                                         Text="Last name is required." />

                            </div>

                        </div>


                        <!-- =====================================
                             EMAIL / PHONE
                             ===================================== -->

                        <div class="form-grid">

                            <div class="form-field">

                                <label class="form-label">
                                    Email
                                </label>

                                <RadzenTextBox Name="Email"
                                               @bind-Value="@model.Email"
                                               Placeholder="e.g. tenant@example.com"
                                               Style="width:100%;" />

                                <RadzenEmailValidator Component="Email"
                                                      Text="Please enter a valid email address." />

                                <div class="form-field-hint">
                                    Email addresses must be unique when provided.
                                </div>

                            </div>


                            <div class="form-field">

                                <label class="form-label">
                                    Phone
                                </label>

                                <RadzenTextBox @bind-Value="@model.Phone"
                                               Placeholder="e.g. 07123 456789"
                                               Style="width:100%;" />

                            </div>

                        </div>


                        <!-- =====================================
                             EMPLOYER / EMERGENCY CONTACT
                             ===================================== -->

                        <div class="form-grid">

                            <div class="form-field">

                                <label class="form-label">
                                    Employer
                                </label>

                                <RadzenTextBox @bind-Value="@model.Employer"
                                               Placeholder="Enter employer"
                                               Style="width:100%;" />

                            </div>


                            <div class="form-field">

                                <label class="form-label">
                                    Emergency Contact
                                </label>

                                <RadzenTextBox @bind-Value="@model.EmergencyContact"
                                               Placeholder="Enter emergency contact number"
                                               Style="width:100%;" />

                            </div>

                        </div>


                        <!-- =====================================
                             FORM ACTIONS
                             ===================================== -->

                        <div class="form-actions">

                            <RadzenButton Text="Cancel"
                                          Icon="close"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@Cancel" />

                            <RadzenButton Text="Save Changes"
                                          Icon="save"
                                          ButtonType="ButtonType.Submit"
                                          Disabled="@isSaving" />

                        </div>


                        @if (isSaving)
                        {
                            <div class="form-saving-message">

                                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                                           Size="ProgressBarCircularSize.Small" />

                                <RadzenText>
                                    Saving changes...
                                </RadzenText>

                            </div>
                        }

                    </RadzenStack>

                </RadzenTemplateForm>

            </div>

        </RadzenCard>
    }

</RadzenStack>


@code
{
    [Parameter]
    public int TenantId { get; set; }

    private EditTenantModel? model;

    private bool isLoading = true;

    private bool isSaving;

    private string? loadErrorMessage;

    private string? saveErrorMessage;


    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadErrorMessage = null;

        saveErrorMessage = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var tenant =
                await db.Tenants
                    .AsNoTracking()
                    .FirstOrDefaultAsync(item =>
                        item.TenantId == TenantId);


            if (tenant == null)
            {
                loadErrorMessage =
                    "The requested tenant could not be found.";

                return;
            }


            model =
                new EditTenantModel
                {
                    FirstName =
                        tenant.FirstName,

                    LastName =
                        tenant.LastName,

                    Email =
                        tenant.Email,

                    Phone =
                        tenant.Phone,

                    Employer =
                        tenant.Employer,

                    EmergencyContact =
                        tenant.EmergencyContact
                };
        }
        catch (Exception ex)
        {
            loadErrorMessage =
                "The selected tenant could not be loaded. Please return to the tenants page and try again.";

            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SaveTenant(
        EditTenantModel value)
    {
        if (isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;
            saveErrorMessage = null;


            await using var db =
                await DbFactory.CreateDbContextAsync();


            if (!string.IsNullOrWhiteSpace(value.Email))
            {
                var emailExists =
                    await db.Tenants.AnyAsync(
                        tenant =>
                            tenant.TenantId != TenantId &&
                            tenant.Email == value.Email.Trim());


                if (emailExists)
                {
                    saveErrorMessage =
                        "Another tenant already uses this email address.";

                    return;
                }
            }


            var tenant =
                await db.Tenants
                    .FirstOrDefaultAsync(item =>
                        item.TenantId == TenantId);


            if (tenant == null)
            {
                saveErrorMessage =
                    "The tenant could not be found.";

                return;
            }


            tenant.FirstName =
                value.FirstName.Trim();

            tenant.LastName =
                value.LastName.Trim();

            tenant.Email =
                string.IsNullOrWhiteSpace(value.Email)
                    ? null
                    : value.Email.Trim();

            tenant.Phone =
                string.IsNullOrWhiteSpace(value.Phone)
                    ? null
                    : value.Phone.Trim();

            tenant.Employer =
                string.IsNullOrWhiteSpace(value.Employer)
                    ? null
                    : value.Employer.Trim();

            tenant.EmergencyContact =
                string.IsNullOrWhiteSpace(value.EmergencyContact)
                    ? null
                    : value.EmergencyContact.Trim();


            await db.SaveChangesAsync();


            Navigation.NavigateTo("/tenants");
        }
        catch (Exception ex)
        {
            saveErrorMessage =
                "The tenant changes could not be saved. Please try again.";

            Console.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo("/tenants");
    }


    private sealed class EditTenantModel
    {
        public string FirstName { get; set; } = "";

        public string LastName { get; set; } = "";

        public string? Email { get; set; }

        public string? Phone { get; set; }

        public string? Employer { get; set; }

        public string? EmergencyContact { get; set; }
    }
}